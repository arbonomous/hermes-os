[Unit]
Description=HermesOS first-boot provisioning
# Only meaningful before the machine is set up. firstbootd itself is a no-op
# once /etc/hermesos/.setup-pending is gone, so this is safe to keep enabled.
ConditionPathExists=/etc/hermesos/.setup-pending
After=network-online.target
Wants=network-online.target
# firstbootd owns the serial console (ttyAMA0 under QEMU). Stop any competing
# serial getty so it can't steal keystrokes from the wizard.
Conflicts=serial-getty@ttyAMA0.service getty@ttyAMA0.service
Before=serial-getty@ttyAMA0.service getty@ttyAMA0.service

[Service]
Type=oneshot
# Root — this is the privileged first-boot boundary (docs/06-install.md §1.2).
User=root
# Runs the LIVE wizard on the boot console (the kernel's /dev/console, which
# is ttyAMA0 under QEMU and tty1 on real hardware). The TUI needs a real tty;
# when stdin is a terminal it shows the interactive wizard, otherwise it falls
# back to unattended auto-provisioning.
Environment=FIRSTBOOT_APPLY=1
TTYPath=/dev/console
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
StandardError=journal
ExecStartPre=/bin/sh -c 'systemctl stop serial-getty@ttyAMA0.service 2>/dev/null || true'
ExecStart=/usr/bin/python3 /usr/lib/hermesos/firstboot/firstbootd.py --apply
# A failed first boot must not wedge the machine — fall back to a shell.
ExecStartPost=/bin/sh -c 'systemctl set-environment HERMES_FIRSTBOOT_DONE=1'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
